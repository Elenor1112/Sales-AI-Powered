# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# Pooled connection string (used by the app at runtime, via src/lib/prisma.ts).
# In Neon, this is the "Pooled connection" string (uses PgBouncer, port 6543 or
# ?pgbouncer=true).
DATABASE_URL=

# Direct/unpooled connection string (used by Prisma CLI for migrations, and
# required for `SELECT ... FOR UPDATE` row locking used by the assignment
# engine, which must run against a real transaction, not a pooled statement
# multiplexer session). In Neon, this is the "Direct connection" string.
DIRECT_URL=

# -----------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth v5)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Meta (Facebook/Instagram) Lead Ads Integration
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v20.0

# -----------------------------------------------------------------------------
# Secrets & Encryption
# -----------------------------------------------------------------------------
# 32-byte key (base64) used to encrypt Meta access tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Shared secret required in the Authorization header for cron-triggered
# backup sync requests (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# -----------------------------------------------------------------------------
# Application behavior (documented defaults; see docs/lead-distribution.md)
# -----------------------------------------------------------------------------
# Whether the seed script inserts example demo leads. Never enable in
# production. Default: leave unset (false) so no fake leads appear in the UI.
SEED_DEMO_LEADS=false

# Minutes after auto-assignment before the default "Contact new lead"
# follow-up task is due. Default: 15.
DEFAULT_FOLLOWUP_MINUTES=15
